graph question_comment_entity {
  graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad="0.18"];
  node [shape=ellipse, fontname="PingFang SC", color="#111111", fontsize=26, penwidth=1.4, width=1.95, height=0.82];
  edge [dir=none, color="#111111", penwidth=1.3];

  entity [shape=box, width=2.6, height=1.15, pos="0,0!", margin="0.22,0.15", label="题目评论"];
  id [shape=ellipse, pos="0,1.95!", label="评论ID"];
  question_id [shape=ellipse, pos="-1.95,0.98!", label="题目ID"];
  user_id [shape=ellipse, pos="1.95,0.98!", label="用户ID"];
  content [shape=ellipse, pos="-2.28,0!", label="评论内容"];
  parent_id [shape=ellipse, pos="2.28,0!", label="父评论ID"];
  likes [shape=ellipse, pos="-1.9,-1.05!", label="点赞数"];
  status [shape=ellipse, pos="1.9,-1.05!", label="状态"];
  create_time [shape=ellipse, pos="0,-1.95!", label="创建时间"];

  entity -- id;
  entity -- question_id;
  entity -- user_id;
  entity -- content;
  entity -- parent_id;
  entity -- likes;
  entity -- status;
  entity -- create_time;
}
