graph question_entity {
  graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad="0.18"];
  node [shape=ellipse, fontname="PingFang SC", color="#111111", fontsize=26, penwidth=1.4, width=1.95, height=0.82];
  edge [dir=none, color="#111111", penwidth=1.3];

  entity [shape=box, width=2.4, height=1.15, pos="0,0!", margin="0.22,0.15", label="题目"];
  id [shape=ellipse, pos="0,1.95!", label="题目ID"];
  project_id [shape=ellipse, pos="-1.95,0.98!", label="项目ID"];
  category_id [shape=ellipse, pos="1.95,0.98!", label="分类ID"];
  title [shape=ellipse, pos="-2.28,0!", label="题目标题"];
  content [shape=ellipse, pos="2.28,0!", label="题干内容"];
  answer [shape=ellipse, pos="-1.9,-1.05!", label="标准答案"];
  difficulty [shape=ellipse, pos="1.9,-1.05!", label="难度等级"];
  type [shape=ellipse, pos="0,-1.95!", label="题目类型"];

  entity -- id;
  entity -- project_id;
  entity -- category_id;
  entity -- title;
  entity -- content;
  entity -- answer;
  entity -- difficulty;
  entity -- type;
}
