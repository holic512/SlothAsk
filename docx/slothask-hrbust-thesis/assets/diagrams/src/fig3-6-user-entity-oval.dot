graph user_entity {
  graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad="0.18"];
  node [shape=ellipse, fontname="PingFang SC", color="#111111", fontsize=26, penwidth=1.4, width=1.95, height=0.82];
  edge [dir=none, color="#111111", penwidth=1.3];

  entity [shape=box, width=2.45, height=1.15, pos="0,0!", margin="0.22,0.15", label="用户"];
  id [shape=ellipse, pos="0,1.95!", label="用户ID"];
  username [shape=ellipse, pos="-1.95,0.98!", label="用户名"];
  email [shape=ellipse, pos="1.95,0.98!", label="邮箱"];
  password [shape=ellipse, pos="-2.28,0!", label="密码"];
  phone [shape=ellipse, pos="2.28,0!", label="手机号"];
  create_time [shape=ellipse, pos="-1.9,-1.05!", label="创建时间"];
  status [shape=ellipse, pos="0,-1.95!", label="状态"];
  update_time [shape=ellipse, pos="1.9,-1.05!", label="更新时间"];

  entity -- id;
  entity -- username;
  entity -- email;
  entity -- password;
  entity -- phone;
  entity -- create_time;
  entity -- status;
  entity -- update_time;
}
