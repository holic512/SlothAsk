graph ai_analysis_entity {
  graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad="0.18"];
  node [shape=ellipse, fontname="PingFang SC", color="#111111", fontsize=26, penwidth=1.4, width=1.95, height=0.82];
  edge [dir=none, color="#111111", penwidth=1.3];

  entity [shape=box, width=2.5, height=1.15, pos="0,0!", margin="0.22,0.15", label="AI分析"];
  id [shape=ellipse, pos="0,1.95!", label="结果ID"];
  record_id [shape=ellipse, pos="-1.95,0.98!", label="记录ID"];
  accuracy [shape=ellipse, pos="1.95,0.98!", label="准确率"];
  explanation [shape=ellipse, pos="-2.28,0!", label="AI解析"];
  source [shape=ellipse, pos="2.28,0!", label="来源模型"];
  create_time [shape=ellipse, pos="-1.9,-1.05!", label="创建时间"];
  update_time [shape=ellipse, pos="1.9,-1.05!", label="更新时间"];
  deleted [shape=ellipse, pos="0,-1.95!", label="删除标记"];

  entity -- id;
  entity -- record_id;
  entity -- accuracy;
  entity -- explanation;
  entity -- source;
  entity -- create_time;
  entity -- update_time;
  entity -- deleted;
}
