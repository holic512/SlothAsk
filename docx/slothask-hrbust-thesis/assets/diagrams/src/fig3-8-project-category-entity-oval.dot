graph project_category_entity {
  graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad="0.18"];
  node [shape=ellipse, fontname="PingFang SC", color="#111111", fontsize=26, penwidth=1.4, width=1.95, height=0.82];
  edge [dir=none, color="#111111", penwidth=1.3];

  entity [shape=box, width=2.65, height=1.15, pos="0,0!", margin="0.22,0.15", label="项目分类"];
  id [shape=ellipse, pos="0,1.95!", label="分类ID"];
  name [shape=ellipse, pos="-1.95,0.98!", label="分类名称"];
  description [shape=ellipse, pos="1.95,0.98!", label="项目描述"];
  sort_order [shape=ellipse, pos="-2.28,0!", label="排序序号"];
  status [shape=ellipse, pos="2.28,0!", label="状态"];
  create_time [shape=ellipse, pos="-1.9,-1.05!", label="创建时间"];
  update_time [shape=ellipse, pos="1.9,-1.05!", label="更新时间"];

  entity -- id;
  entity -- name;
  entity -- description;
  entity -- sort_order;
  entity -- status;
  entity -- create_time;
  entity -- update_time;
}
