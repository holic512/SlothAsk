graph wrong_question_book_entity {
  graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad="0.18"];
  node [shape=ellipse, fontname="PingFang SC", color="#111111", fontsize=26, penwidth=1.4, width=1.95, height=0.82];
  edge [dir=none, color="#111111", penwidth=1.3];

  entity [shape=box, width=2.5, height=1.15, pos="0,0!", margin="0.22,0.15", label="错题本"];
  id [shape=ellipse, pos="0,1.95!", label="记录ID"];
  user_id [shape=ellipse, pos="-1.95,0.98!", label="用户ID"];
  question_id [shape=ellipse, pos="1.95,0.98!", label="题目ID"];
  wrong_count [shape=ellipse, pos="-2.28,0!", label="错误次数"];
  last_time [shape=ellipse, pos="2.28,0!", label="最后错误时间"];
  last_answer [shape=ellipse, pos="-1.9,-1.05!", label="最后错误答案"];
  remark [shape=ellipse, pos="1.9,-1.05!", label="用户备注"];
  update_time [shape=ellipse, pos="0,-1.95!", label="更新时间"];

  entity -- id;
  entity -- user_id;
  entity -- question_id;
  entity -- wrong_count;
  entity -- last_time;
  entity -- last_answer;
  entity -- remark;
  entity -- update_time;
}
