graph question_category_entity {
  graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad="0.18"];
  node [shape=ellipse, fontname="PingFang SC", color="#111111", fontsize=26, penwidth=1.4, width=1.95, height=0.82];
  edge [dir=none, color="#111111", penwidth=1.3];

  entity [shape=box, width=2.65, height=1.15, pos="0,0!", margin="0.22,0.15", label="题库分类"];
  id [shape=ellipse, pos="0,1.95!", label="分类ID"];
  project_id [shape=ellipse, pos="-1.95,0.98!", label="所属项目ID"];
  name [shape=ellipse, pos="1.95,0.98!", label="分类名称"];
  creator_id [shape=ellipse, pos="-2.28,0!", label="创建者ID"];
  avatar [shape=ellipse, pos="2.28,0!", label="分类头像"];
  description [shape=ellipse, pos="-1.9,-1.05!", label="分类描述"];
  views [shape=ellipse, pos="1.9,-1.05!", label="访问数量"];
  status [shape=ellipse, pos="0,-1.95!", label="状态"];

  entity -- id;
  entity -- project_id;
  entity -- name;
  entity -- creator_id;
  entity -- avatar;
  entity -- description;
  entity -- views;
  entity -- status;
}
