graph user_profile_entity {
  graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad="0.18"];
  node [shape=ellipse, fontname="PingFang SC", color="#111111", fontsize=26, penwidth=1.4, width=1.95, height=0.82];
  edge [dir=none, color="#111111", penwidth=1.3];

  entity [shape=box, width=2.6, height=1.15, pos="0,0!", margin="0.22,0.15", label="用户资料"];
  id [shape=ellipse, pos="0,1.95!", label="资料ID"];
  user_id [shape=ellipse, pos="-1.95,0.98!", label="用户ID"];
  nickname [shape=ellipse, pos="1.95,0.98!", label="昵称"];
  avatar [shape=ellipse, pos="-2.28,0!", label="头像"];
  gender [shape=ellipse, pos="2.28,0!", label="性别"];
  location [shape=ellipse, pos="-1.9,-1.05!", label="地区"];
  occupation [shape=ellipse, pos="1.9,-1.05!", label="职业"];
  achievement [shape=ellipse, pos="0,-1.95!", label="成就展示"];

  entity -- id;
  entity -- user_id;
  entity -- nickname;
  entity -- avatar;
  entity -- gender;
  entity -- location;
  entity -- occupation;
  entity -- achievement;
}
