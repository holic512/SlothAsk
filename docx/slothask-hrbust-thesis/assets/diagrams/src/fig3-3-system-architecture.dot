digraph architecture {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="filled", fillcolor="white", color="#111111", fontname="PingFang SC", penwidth=1.1];
  edge [color="#111111", penwidth=1.0, arrowsize=0.7];

  browser [label="用户端浏览器\n管理端浏览器", width=2.1, height=0.9, fixedsize=true];
  gateway [label="API网关\n路由转发\n身份头注入", width=1.9, height=1.0, fixedsize=true];
  question [label="Service-Question\n题库、答题、搜索、统计", width=2.2, height=1.05, fixedsize=true];
  ai [label="Service-Ai\n嵌入生成\nAI解析执行", width=1.8, height=1.0, fixedsize=true];
  notify [label="Service-Notification\nSSE推送\n基础消息", width=1.9, height=1.0, fixedsize=true];
  user [label="Service-User / Service-Admin\n用户与后台认证", width=2.3, height=1.0, fixedsize=true];
  mq [label="RabbitMQ", width=1.3, height=0.6, fixedsize=true];
  mysql [label="MySQL", width=1.3, height=0.6, fixedsize=true];
  redis [label="Redis", width=1.3, height=0.6, fixedsize=true];
  qdrant [label="Qdrant", width=1.3, height=0.6, fixedsize=true];

  browser -> gateway;
  gateway -> question;
  gateway -> notify;
  gateway -> user;

  question -> mysql;
  question -> redis;
  question -> mq;
  question -> qdrant;
  question -> ai;

  ai -> mq;
  ai -> mysql;
  ai -> redis;
  notify -> redis;
  user -> mysql;

  { rank=same; question; ai; notify; user; }
  { rank=same; mq; mysql; redis; qdrant; }
}
